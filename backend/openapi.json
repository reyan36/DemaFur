  "components": {
    "schemas": {
      "ActionDecision": {
        "properties": {
          "approved": {
            "type": "boolean",
            "title": "Approved"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "approved"
        ],
        "title": "ActionDecision"
      },
      "Confirmation": {
        "properties": {
          "outcome": {
            "type": "string",
            "pattern": "^(expected|missing|unsure)$",
            "title": "Outcome"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome"
        ],
        "title": "Confirmation"
      },
      "EventIn": {
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$",
            "title": "Event Id"
          },
          "delivery_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$",
            "title": "Delivery Id"
          },
          "camera_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$",
            "title": "Camera Id"
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 1
          },
          "observations": {
            "$ref": "#/components/schemas/Observations"
          },
          "media_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./-]{1,250}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Media Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "delivery_id",
          "camera_id",
          "kind",
          "occurred_at"
        ],
        "title": "EventIn"
      },
      "EventKind": {
        "type": "string",
        "enum": [
          "package_delivered",
          "motion",
          "person_approached",
          "person_lingering",
          "package_removed",
          "entered_home",
          "doorbell"
        ],
        "title": "EventKind"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Observations": {
        "properties": {
          "duration_seconds": {
            "type": "number",
            "maximum": 86400.0,
            "minimum": 0.0,
            "title": "Duration Seconds",
            "default": 0
          },
          "looking_around": {
            "type": "boolean",
            "title": "Looking Around",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Observations"
      },
      "PickupIn": {
        "properties": {
          "delivery_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$",
            "title": "Delivery Id"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          },

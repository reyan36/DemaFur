# Generate two different secrets: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DEMAFUR_API_KEY=
DEMAFUR_WEBHOOK_SECRET=
# Copy the PostgreSQL session pooler connection string from Supabase Connect.
DATABASE_URL=
# Optional separate migration credential; otherwise DATABASE_URL is used.
MIGRATION_DATABASE_URL=
DATABASE_SSLMODE=require
DEMAFUR_DATA_DIR=./data
# SQLite is available only for explicit local demos/tests.
DEMAFUR_ALLOW_SQLITE=false
DEMAFUR_DB=./data/demafur.sqlite3
AI_PROVIDER=bedrock
AWS_REGION=
BEDROCK_MODEL_ID=
BEDROCK_VISION_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Alternative Bedrock SDK credential; use only one credential method.
AWS_BEARER_TOKEN_BEDROCK=
GROQ_FALLBACK_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=
DEMAFUR_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEMAFUR_RETENTION_DAYS=30
# Legacy only: requires AI_PROVIDER=openai. Not needed for Bedrock.
OPENAI_API_KEY=
OPENAI_MODEL=

# Ring developer app credentials. Do not use a consumer Ring password.
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_SIGNING_KEY=
# Optional for an already-linked account; native linking discovers the account ID.
RING_ACCOUNT_ID=
RING_REFRESH_TOKEN=
# Explicit opt-in: sends sampled event images to the configured AI provider. Off by default.
DEMAFUR_VISION_ENABLED=false
OPENAI_VISION_MODEL=
# Defaults to a media directory under DEMAFUR_DATA_DIR. Do not commit recordings.
DEMAFUR_MEDIA_DIR=
# Leave empty to find ffmpeg on PATH. The Docker image installs FFmpeg.
FFMPEG_PATH=
DEMAFUR_WORKER_INTERVAL_SECONDS=15

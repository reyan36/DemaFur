# Generate two different secrets: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DEMAFUR_API_KEY=
DEMAFUR_WEBHOOK_SECRET=
DEMAFUR_DB=./data/demafur.sqlite3
DEMAFUR_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEMAFUR_RETENTION_DAYS=30
# Optional: both values must be present to enable remote AI narration.
OPENAI_API_KEY=
OPENAI_MODEL=

# Ring developer app credentials. Do not use a consumer Ring password.
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_SIGNING_KEY=
# Optional for an already-linked account; native linking discovers the account ID.
RING_ACCOUNT_ID=
RING_REFRESH_TOKEN=
# Explicit opt-in: sends sampled event images to OpenAI. Off by default.
DEMAFUR_VISION_ENABLED=false
OPENAI_VISION_MODEL=
# Defaults to a media directory beside the database. Do not commit recordings.
DEMAFUR_MEDIA_DIR=
# Leave empty to find ffmpeg on PATH. The Docker image installs FFmpeg.
FFMPEG_PATH=
DEMAFUR_WORKER_INTERVAL_SECONDS=15
